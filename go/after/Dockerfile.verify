# 検証用 (DHI static のCommunity catalogでtagが見つからなかった環境向け代替)
# 最終stageを dhi.io/golang:1.25 (non-dev runtime) にして動作だけ確認する形
# syntax=docker/dockerfile:1
FROM dhi.io/golang:1.25-dev AS builder
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/server ./cmd/server

FROM dhi.io/golang:1.25
WORKDIR /app
COPY --from=builder /app/server /app/server
USER nonroot
EXPOSE 8080
ENTRYPOINT ["/app/server"]
